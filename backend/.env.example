DATABASE_URL="postgresql://user:password@localhost:5432/elms_db?schema=public"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"
FRONTEND_URL="http://localhost:5173"

# Email configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="ELMS <noreply@elms.edu>"

# ABA PayWay eCommerce API (automatic payment verification)
# Sandbox keys: https://sandbox.payway.com.kh/register-sandbox/
# Production keys: contact paywaysales@ababank.com
ABA_PAYWAY_MERCHANT_ID=""
ABA_PAYWAY_API_KEY=""
ABA_PAYWAY_API_SECRET=""
ABA_PAYWAY_BASE_URL="https://checkout-sandbox.payway.com.kh"

# Public URL where PayWay can POST the payment callback (use ngrok in dev)
BACKEND_PUBLIC_URL="http://localhost:5000"

# Shared secret required by the legacy /payments/webhook/:gateway endpoint.
# Required in production; optional for local sandbox testing.
PAYMENT_WEBHOOK_SECRET=""

# Allows a payment owner to sandbox-confirm their own pending payment.
# Only honoured outside production. Set to false to disable even in development.
ALLOW_SANDBOX_PAYMENT_CONFIRM="true"

# Fallback static link used only when PayWay API keys are not configured
ABA_PAY_LINK="https://pay.ababank.com/oRF8/sv3e85w1"
# ACLEDA PayWay payment page link (provided after ACLEDA merchant onboarding)
ACLEDA_PAY_LINK=""

# Other gateway placeholders
KHQR_API_KEY=""
BAKONG_API_KEY=""

# App environment
NODE_ENV="development"
PORT="5000"